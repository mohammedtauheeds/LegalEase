# ==============================================================================
# LegalEase Environment Configuration Template
# Duplicate this file as .env and populate your values. Never commit .env.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key-for-sessions
HOST=127.0.0.1
PORT=5000

# Google Gemini API Configuration (Official google-genai SDK)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Centrally configurable supported Gemini Flash model (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Courts & Cases API Configuration
COURTS_CASES_BASE_URL=https://courtsandcases.com
COURTS_CASES_API_KEY=optional_api_key_if_required

# Database Configuration (SQLite stored locally in instance/ directory)
DATABASE_URL=sqlite:///instance/legalease.db

# NLP & Machine Learning Settings
# Cosine similarity threshold (0.0 to 1.0) for direct FAQ matches
NLP_SIMILARITY_THRESHOLD=0.75

# External Request Settings
EXTERNAL_API_TIMEOUT=5
